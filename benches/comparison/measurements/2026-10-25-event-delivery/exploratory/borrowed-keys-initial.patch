+}
+
+fn reference_key(value: &str) -> Cow<'_, str> {
+    if !value.starts_with(' ')
+        && !value.ends_with(' ')
+        && value.bytes().all(|byte| {
+            byte.is_ascii() && !byte.is_ascii_uppercase() && !matches!(byte, b'\t' | b'\r' | b'\n')
+        })
+        && !value.contains("  ")
+    {
+        Cow::Borrowed(value)
+    } else {
+        Cow::Owned(owned_reference_key(value))
+    }
+}
+
+pub(crate) fn normalize_reference_key_into(value: &str, result: &mut String) {
+    crate::util::normalize_identifier::normalize_identifier_into(value, result);
+    result.make_ascii_lowercase();
+}
