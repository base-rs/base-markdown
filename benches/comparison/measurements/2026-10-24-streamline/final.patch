+#[inline]
+pub(crate) fn find_escape(bytes: &[u8], encode: bool) -> usize {
+    static ESCAPES: crate::byte_scan::AsciiSet = crate::byte_scan::AsciiSet::new(b"\0&\"<>");
+    if encode {
