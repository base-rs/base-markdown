+/// Borrow an unchanged label, or normalize only the suffix after its canonical ASCII prefix.
+pub(crate) fn normalize_reference_identifier(value: &str) -> Cow<'_, str> {
+    let mut previous = b' ';
+    let mut end = value.len();
+    for (index, byte) in value.bytes().enumerate() {
+        if !byte.is_ascii()
+            || byte.is_ascii_uppercase()
+            || matches!(byte, b'\t' | b'\r' | b'\n')
+            || byte == b' ' && previous == b' '
+        {
+            end = index;
+            break;
+        }
+        previous = byte;
+    }
+    if end == value.len() && (value.is_empty() || previous != b' ') {
+        return Cow::Borrowed(value);
+    }
+    // Keep the whitespace boundary with the suffix so trimming and collapse also work across the split.
+    end = end.saturating_sub(usize::from(previous == b' '));
+    let mut result = String::with_capacity(value.len());
+    result.push_str(&value[..end]);
+    append_reference_identifier(&value[end..], &mut result);
+    Cow::Owned(result)
+}
