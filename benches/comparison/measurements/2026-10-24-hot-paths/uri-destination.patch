+
+#[cfg(test)]
+mod tests {
+    use super::write_destination;
+    use alloc::string::String;
+    use core::fmt::{self, Write};
+
+    #[test]
+    fn failed_destination_writes_preserve_the_last_completed_byte() {
+        struct Writer {
+            output: String,
+            fail_on: &'static str,
+        }
+        impl Write for Writer {
+            fn write_str(&mut self, value: &str) -> fmt::Result {
+                if value == self.fail_on {
+                    return Err(fmt::Error);
+                }
+                self.output.push_str(value);
+                Ok(())
+            }
+        }
+        for (value, fail_on, expected, byte) in [
+            ("value&tail", "&amp;", "value", b'e'),
+            ("valueé", "%C3", "value", b'e'),
+            ("é", "%A9", "%C3", b'3'),
+            ("&tail", "tail", "&amp;", b';'),
+            ("%GG", "%GG", "", b'"'),
+            ("%", "%25", "", b'"'),
+        ] {
+            let mut writer = Writer {
+                output: String::new(),
+                fail_on,
+            };
+            // The opening href/src attribute has already written its quote.
+            let mut last = Some(b'"');
+            assert!(write_destination(&mut writer, &mut last, value, None).is_err());
+            assert_eq!(writer.output, expected);
+            assert_eq!(last, Some(byte));
+        }
+    }
+}
