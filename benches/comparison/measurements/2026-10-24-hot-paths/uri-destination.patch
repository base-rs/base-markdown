+// A destination can emit multiple percent escapes and HTML replacements; keep its writer selected for the whole value.
+fn write_destination(
+    output: &mut impl Write,
+    last: &mut Option<u8>,
+    value: &str,
+    protocols: Option<&[&str]>,
+) -> fmt::Result {
+    write_sanitized(value, protocols, |value| {
+        output.write_str(value)?;
+        if let Some(&byte) = value.as_bytes().last() {
+            *last = Some(byte);
+        }
+        Ok(())
+    })
+}
