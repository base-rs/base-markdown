+
+    // Direct rendering fixes the producer for the entire document. Keep the public iterator's per-call dispatch for consumers that pull individual events.
+    pub(crate) fn for_each_event(
+        &mut self,
+        mut consume: impl FnMut(&Event<'static>) -> Result<(), StreamError>,
+    ) -> Result<(), StreamError> {
+        fn consume_events(
+            events: &mut impl Iterator<Item = Result<Event<'static>, StreamError>>,
+            consume: &mut impl FnMut(&Event<'static>) -> Result<(), StreamError>,
+        ) -> Result<(), StreamError> {
+            for event in events {
+                consume(&event?)?;
+            }
+            Ok(())
+        }
+        match &mut self.producer {
+            Producer::Compact(parser) => consume_events(parser, &mut consume),
+            Producer::Compatibility(parser) => consume_events(parser, &mut consume),
+        }
+    }
